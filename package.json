{
  "name": "@invoicekit/einvoice",
  "version": "0.2.3",
  "description": "EN 16931 e-invoice validation (CII and UBL) in the browser or Node — the same pure-Go engine as the Go library, compiled to WebAssembly.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "NOTICE.md",
    "LICENSES"
  ],
  "sideEffects": false,
  "license": "MIT",
  "keywords": [
    "en16931",
    "e-invoicing",
    "factur-x",
    "zugferd",
    "xrechnung",
    "peppol",
    "ubl",
    "cii",
    "validation",
    "wasm"
  ],
  "homepage": "https://github.com/DCNWS/invoicekit.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DCNWS/invoicekit.ts.git"
  },
  "bugs": {
    "url": "https://github.com/DCNWS/invoicekit.ts/issues"
  },
  "author": "Winston Hale",
  "scripts": {
    "build:wasm": "./scripts/build-wasm.sh",
    "build": "tsc -p .",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p . --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
